# Database (XAMPP defaults; change these for a hosted MySQL in production)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_db
# Set to true for hosted MySQL providers that require SSL (e.g. Aiven, PlanetScale)
DB_SSL=false

# Server
PORT=3000
NODE_ENV=development
SESSION_TTL_HOURS=12
# Optional: comma-separated browser origins allowed to call the API.
# Leave empty to allow all origins (the API still requires a token).
CORS_ORIGINS=

# Default accounts created on first server start (change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
STAFF_USERNAME=staff
STAFF_PASSWORD=staff123
